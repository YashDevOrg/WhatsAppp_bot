OPENAI_API_KEY=sk-proj-your-key-here

# Match either contact id or displayed contact name. Prefer number if possible.
# Number format usually looks like 919876543210@c.us.
WA_TARGET_CONTACT=
WA_TARGET_NAME=
WA_TARGET_NUMBER=
DEBUG_MESSAGES=false
HEADLESS=true
READY_TIMEOUT_SECONDS=120
FALLBACK_REPLIES=Hey, I am a little busy right now. I will text you properly in a bit.|I saw your message, love. I will reply properly soon.|I am caught up right now, but I am here. Text you in a bit.

# Start with false. Change to true only when you are happy with the replies.
AUTO_SEND=false

# Reply controls.
COOLDOWN_MINUTES=10
MAX_REPLY_CHARS=180
MODEL=gpt-4.1-mini

# Optional: add your natural style in one short sentence.
REPLY_STYLE=short, warm, casual, caring, and natural
